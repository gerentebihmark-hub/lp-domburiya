{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/blinkgleba", "destination": "/blinkgleba/index.html" },
    { "source": "/blinkgleba/", "destination": "/blinkgleba/index.html" },
    { "source": "/blinkcentro", "destination": "/blinkcentro/index.html" },
    { "source": "/blinkcentro/", "destination": "/blinkcentro/index.html" },
    { "source": "/blinkmaringa", "destination": "/blinkmaringa/index.html" },
    { "source": "/blinkmaringa/", "destination": "/blinkmaringa/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "redirects": [
    { "source": "/cardapio", "destination": "/#cardapio", "permanent": false },
    { "source": "/unidades", "destination": "/#unidades", "permanent": false },
    { "source": "/delivery", "destination": "https://domburiya.cloudfy.net.br/", "permanent": false }
  ]
}
